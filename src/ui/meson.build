# editor/plugins depend back on ui, so they're left out here and resolved at
# the final executable link instead. Scintilla/libgit2/libssh2 are listed
# directly since ui headers include them too, and moc needs to parse those.
ui_deps = [
    pawmmit_common,
    pawmmitUtil_dep,
    conf_dep,
    cred_dep,
    dialogs_dep,
    git_dep,
    host_dep,
    index_dep,
    loglib_dep,
    platform_dep,
    tools_dep,
    update_dep,
    watcher_dep,
    hunspell_dep,
    libgit2_dep,
    libssh2_dep,
    lexilla_dep,
    scintilla_dep,
    scintillua_dep,
]

ui_moc = qt6.preprocess(
    moc_headers: files(
        'blame/BlameEditor.h',
        'blame/BlameMargin.h',
        'commits/CommitList.h',
        'commits/CommitModel.h',
        'commits/CommitToolBar.h',
        'detail/CommitEditor.h',
        'detail/DetailView.h',
        'detail/DoubleTreeWidget.h',
        'detail/TemplateButton.h',
        'detail/TemplateDialog.h',
        'detail/TreeWidget.h',
        'diffView/DiffView.h',
        'diffView/EditButton.h',
        'diffView/FileWidget.h',
        'diffView/HunkWidget.h',
        'diffView/Images.h',
        'filetree/ColumnView.h',
        'filetree/DiffTreeModel.h',
        'filetree/FileContextMenu.h',
        'filetree/IgnoreDialog.h',
        'filetree/TreeModel.h',
        'filetree/TreeProxy.h',
        'filetree/TreeView.h',
        'hotkeys/HotkeyManager.h',
        'hotkeys/HotkeyToolTip.h',
        'references/ReferenceList.h',
        'references/ReferenceModel.h',
        'references/ReferenceView.h',
        'references/ReferenceWidget.h',
        'repo/History.h',
        'repo/PathspecWidget.h',
        'repo/RemoteCallbacks.h',
        'repo/RepoView.h',
        'repo/StateBanner.h',
        'search/AdvancedSearchWidget.h',
        'search/SearchField.h',
        'window/EditorWindow.h',
        'window/MainWindow.h',
        'window/MenuBar.h',
        'window/SideBar.h',
        'window/StateAction.h',
        'window/TabBar.h',
        'window/TabWidget.h',
        'window/ToolBar.h',
        'ExpandButton.h',
        'FindWidget.h',
        'Footer.h',
        'StatePushButton.h',
    ),
    moc_sources: files(
        'detail/CommitEditor.cpp',
        'detail/DetailView.cpp',
        'filetree/ColumnView.cpp',
        'references/ReferenceView.cpp',
        'repo/RepoView.cpp',
        'search/IndexCompleter.cpp',
        'search/SearchField.cpp',
        'window/SideBar.cpp',
        'window/TabWidget.cpp',
        'window/ToolBar.cpp',
    ),
    dependencies: ui_deps,
)

ui_src = files(
    'blame/BlameEditor.cpp',
    'blame/BlameMargin.cpp',
    'commits/CommitContextMenu.cpp',
    'commits/CommitDelegate.cpp',
    'commits/CommitGraph.cpp',
    'commits/CommitList.cpp',
    'commits/CommitModel.cpp',
    'commits/CommitToolBar.cpp',
    'commits/ConfigKeys.cpp',
    'detail/CommitEditor.cpp',
    'detail/DetailView.cpp',
    'detail/DoubleTreeWidget.cpp',
    'detail/SpellChecker.cpp',
    'detail/TemplateButton.cpp',
    'detail/TemplateDialog.cpp',
    'detail/TreeWidget.cpp',
    'diffView/Comment.cpp',
    'diffView/DiffView.cpp',
    'diffView/EditButton.cpp',
    'diffView/FileLabel.cpp',
    'diffView/FileWidget.cpp',
    'diffView/HunkWidget.cpp',
    'diffView/Images.cpp',
    'filetree/ColumnView.cpp',
    'filetree/DiffTreeModel.cpp',
    'filetree/FileContextMenu.cpp',
    'filetree/IgnoreDialog.cpp',
    'filetree/TreeModel.cpp',
    'filetree/TreeProxy.cpp',
    'filetree/TreeView.cpp',
    'filetree/ViewDelegate.cpp',
    'hotkeys/HotkeyManager.cpp',
    'hotkeys/HotkeyToolTip.cpp',
    'references/ReferenceList.cpp',
    'references/ReferenceModel.cpp',
    'references/ReferenceView.cpp',
    'references/ReferenceWidget.cpp',
    'repo/ConflictLabel.cpp',
    'repo/History.cpp',
    'repo/Location.cpp',
    'repo/PathspecWidget.cpp',
    'repo/RemoteCallbacks.cpp',
    'repo/RepoLinkHandler.cpp',
    'repo/RepoView.cpp',
    'repo/StateBanner.cpp',
    'search/AdvancedSearchWidget.cpp',
    'search/IndexCompleter.cpp',
    'search/SearchField.cpp',
    'window/EditorWindow.cpp',
    'window/MainWindow.cpp',
    'window/MenuBar.cpp',
    'window/SideBar.cpp',
    'window/StateAction.cpp',
    'window/TabBar.cpp',
    'window/TabWidget.cpp',
    'window/ToolBar.cpp',
    'Badge.cpp',
    'ContextMenuButton.cpp',
    'ExpandButton.cpp',
    'FindWidget.cpp',
    'Footer.cpp',
    'ProgressIndicator.cpp',
    'StatePushButton.cpp',
)

ui_lib = static_library(
    'ui',
    ui_src + ui_moc,
    cpp_args: ['-DBUILD_DESCRIPTION="' + build_description + '"'],
    dependencies: ui_deps,
)

ui_dep = declare_dependency(
    link_with: ui_lib,
    include_directories: include_directories('.'),
)