From 6f6696f8b2352497f8f158211c3cdcc65c343f92 Mon Sep 17 00:00:00 2001
From: Sven Over <sven@svenover.de>
Date: Fri, 9 Oct 2026 19:00:31 +0100
Subject: [PATCH 1/2] revwalk: start limited walks from the newest commits

A walk with hidden commits (a "limited" walk) looks at commits in the
order of a list that starts out with the commits it was given, and stops
once only uninteresting commits are left in it. That list was in the
order the commits were added to the walk, the most recently added first.
So when a caller pushes the commits it wants and then hides others, the
walk starts with the hidden commits, and follows their history until it
gets to the commits it is meant to show.

That's how pushing sets up its walk: it pushes the commits to send, then
hides every reference the remote advertises. The local transport's fetch
does the same with the references of the repository it fetches into. In
a large repository with many references, the walk then goes through a
lot of history before it even looks at the commits to send.

Sort the commits a limited walk starts from by date, newest first, as
git does (in prepare_revision_walk). The walk then starts with the
commits to show, and stops shortly after them. Walks without hidden
commits keep their order, which fetch negotiation relies on.

Measured with a clone of llvm-project, walking from a new commit on top
of main while hiding all 1569 references GitHub advertises for it (as
pushing does): 17.1s before, 0.03s after.
---
 src/libgit2/revwalk.c         | 48 ++++++++++++++++++++++++++++++++++-
 tests/libgit2/revwalk/basic.c | 41 ++++++++++++++++++++++++++++++
 2 files changed, 88 insertions(+), 1 deletion(-)

diff --git a/src/libgit2/revwalk.c b/src/libgit2/revwalk.c
index 1e28009..d0a6389 100644
--- a/src/libgit2/revwalk.c
+++ b/src/libgit2/revwalk.c
@@ -948,13 +948,59 @@ static int prepare_incremental_toposort_walk(git_revwalk *walk,
 	return 0;
 }
 
+/*
+ * Sort the commits a limited walk starts from by date, newest first, like
+ * git does. Limiting goes on as long as interesting commits are left to
+ * look at: if the commits to show came after the commits to hide (e.g.
+ * many of them, like a remote's advertised references), we would walk the
+ * history of the hidden ones until we got there, however far that goes.
+ */
+static int sort_by_date(git_commit_list **list)
+{
+	git_vector commits = GIT_VECTOR_INIT;
+	git_commit_list *item, *sorted = NULL, **p = &sorted;
+	git_commit_list_node *commit;
+	size_t i;
+	int error;
+
+	if ((error = git_vector_init(&commits, 0, git_commit_list_time_cmp)) < 0)
+		return error;
+
+	for (item = *list; item; item = item->next) {
+		if ((error = git_vector_insert(&commits, item->item)) < 0)
+			goto done;
+	}
+
+	git_vector_sort(&commits);
+
+	git_vector_foreach(&commits, i, commit) {
+		if ((item = git_commit_list_insert(commit, p)) == NULL) {
+			error = -1;
+			goto done;
+		}
+
+		p = &item->next;
+	}
+
+	git_commit_list_free(list);
+	*list = sorted;
+	sorted = NULL;
+
+done:
+	git_commit_list_free(&sorted);
+	git_vector_dispose(&commits);
+	return error;
+}
+
 /* Prepare revwalk without using generation number */
 static int prepare_full_walk(git_revwalk *walk, git_commit_list *commits)
 {
 	git_commit_list *list;
 	int error = 0;
 
-	if (walk->limited && (error = limit_list(&commits, walk, commits)) < 0)
+	if (walk->limited &&
+	    ((error = sort_by_date(&commits)) < 0 ||
+	     (error = limit_list(&commits, walk, commits)) < 0))
 		return error;
 
 	if (walk->sorting & GIT_SORT_TOPOLOGICAL) {
diff --git a/tests/libgit2/revwalk/basic.c b/tests/libgit2/revwalk/basic.c
index 920afc7..421a52a 100644
--- a/tests/libgit2/revwalk/basic.c
+++ b/tests/libgit2/revwalk/basic.c
@@ -648,3 +648,44 @@ void test_revwalk_basic__newer_hidden_commit_hides_old_commits(void)
 
 	cl_git_fail_with(GIT_ITEROVER, git_revwalk_next(&oid, _walk));
 }
+
+/*
+ * A walk with hidden commits looks at the newest commits first, and stops
+ * once only hidden commits are left, no matter in which order commits
+ * were pushed and hidden. Here, it doesn't look at the parent of an old
+ * hidden commit (which doesn't even exist).
+ *
+ * % git rev-list a65fedf ^be3563a
+ * a65fedf39aefe402d3bb6e24df4d4f5fe4547750
+ */
+void test_revwalk_basic__hidden_commits_walked_from_newest(void)
+{
+	const char *old_commit =
+		"tree 4b825dc642cb6eb9a060e54bf8d69288fbee4904\n"
+		"parent 0123456789012345678901234567890123456789\n"
+		"author A U Thor <author@example.com> 0 +0000\n"
+		"committer A U Thor <author@example.com> 0 +0000\n"
+		"\n"
+		"an old commit whose parent doesn't exist\n";
+	git_oid old_id, oid;
+	git_odb *odb;
+
+	revwalk_basic_setup_walk("testrepo.git");
+
+	cl_git_pass(git_repository_odb(&odb, _repo));
+	cl_git_pass(git_odb_write(&old_id, odb, old_commit,
+		strlen(old_commit), GIT_OBJECT_COMMIT));
+	git_odb_free(odb);
+
+	cl_git_pass(git_oid_from_string(&oid, "a65fedf39aefe402d3bb6e24df4d4f5fe4547750", GIT_OID_SHA1));
+	cl_git_pass(git_revwalk_push(_walk, &oid));
+	cl_git_pass(git_oid_from_string(&oid, "be3563ae3f795b2b4353bcce3a527ad0a4f7f644", GIT_OID_SHA1));
+	cl_git_pass(git_revwalk_hide(_walk, &oid));
+	cl_git_pass(git_revwalk_hide(_walk, &old_id));
+
+	cl_git_pass(git_revwalk_next(&oid, _walk));
+	cl_assert(!git_oid_streq(&oid, "a65fedf39aefe402d3bb6e24df4d4f5fe4547750"));
+
+	cl_git_fail_with(GIT_ITEROVER, git_revwalk_next(&oid, _walk));
+}
+
-- 
