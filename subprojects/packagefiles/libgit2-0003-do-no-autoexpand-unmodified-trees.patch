From 3a18f0d1d584b78657ffdc300b8d082a07513975 Mon Sep 17 00:00:00 2001
From: Sergey Kazmin <cergei.kazmin@gmail.com>
Date: Tue, 29 Sep 2026 15:44:43 +0000
Subject: [PATCH 8/8] diff: fix skipping of unmodified trees

Compare only the ids of two trees at the same path instead of calling
maybe_modified on them.  maybe_modified passed a delta for the tree to
the notify callback, and a callback that skipped it made the diff skip
the whole tree.  With GIT_DIFF_IGNORE_CASE and
GIT_DIFF_INCLUDE_CASECHANGE it added two deltas for a tree, and only
one of them was removed.

Detect trees with S_ISDIR like the tree iterator does, so that trees
with a mode like 040755 are expanded too.

Expand only the tree that comes next.  With
GIT_DIFF_INCLUDE_TYPECHANGE_TREES, also expand the trees that sort
between a file `a` and `a/`, since typechange detection compares `a`
with the next entry on the other side.

Do not skip trees in case insensitive diffs: the case insensitive tree
iterator merges trees whose names differ only in case, so one of them
cannot be skipped on its own.  Return tree entries also when the diff
options are NULL.

Add tests for these cases.
---
 src/libgit2/diff_generate.c | 200 +++++++++++++++++------------
 tests/libgit2/diff/tree.c   | 250 ++++++++++++++++++++++++++++++++++++
 2 files changed, 365 insertions(+), 85 deletions(-)

diff --git a/src/libgit2/diff_generate.c b/src/libgit2/diff_generate.c
index 9581dc70c78..b492ca15198 100644
--- a/src/libgit2/diff_generate.c
+++ b/src/libgit2/diff_generate.c
@@ -802,8 +802,7 @@ static int maybe_modified_submodule(
 
 static int maybe_modified(
 	git_diff_generated *diff,
-	diff_in_progress *info,
-	bool skip_pathspec_match)
+	diff_in_progress *info)
 {
 	git_oid noid;
 	git_delta_t status = GIT_DELTA_MODIFIED;
@@ -813,15 +812,13 @@ static int maybe_modified(
 	unsigned int nmode = nitem->mode;
 	bool new_is_workdir = (info->new_iter->type == GIT_ITERATOR_WORKDIR);
 	bool modified_uncertain = false;
-	const char *matched_pathspec = NULL;
+	const char *matched_pathspec;
 	int error = 0;
 
 	git_oid_clear(&noid, diff->base.opts.oid_type);
 
-	if (!skip_pathspec_match) {
-		if (!diff_pathspec_match(&matched_pathspec, diff, oitem))
-			return 0;
-	}
+	if (!diff_pathspec_match(&matched_pathspec, diff, oitem))
+		return 0;
 
 	/* on platforms with no symlinks, preserve mode of existing symlinks */
 	if (S_ISLNK(omode) && S_ISREG(nmode) && new_is_workdir &&
@@ -1045,32 +1042,93 @@ static int iterator_advance_over(
 	return error;
 }
 
-static int iterator_expand_until_not_tree_entry(
-	const git_index_entry **entry,
-	const git_index_entry *current_entry, 
-	git_iterator *iterator)
+GIT_INLINE(bool) iterator_is_tree(git_iterator *iterator)
 {
-	int error = 0;
+	return iterator->type == GIT_ITERATOR_TREE ||
+		iterator->type == GIT_ITERATOR_EMPTY;
+}
 
-	while (current_entry && current_entry->mode == GIT_FILEMODE_TREE) {
-		if ((error = iterator_advance_into(entry, iterator)) < 0) {
-			return error;
-		}
-		current_entry = *entry;
-	}
+GIT_INLINE(bool) iterator_returns_trees(git_iterator *iterator)
+{
+	return iterator->type == GIT_ITERATOR_TREE &&
+		(iterator->flags & GIT_ITERATOR_DONT_AUTOEXPAND) != 0;
+}
 
-	return error;
+/*
+ * Whether the tree sorts between the item `a` and the path `a/`, or is
+ * `a/` itself (eg, `a.txt/` or `a-b/`).
+ */
+static bool tree_sorts_before_subdir(
+	git_diff_generated *diff,
+	const git_index_entry *tree_item,
+	const git_index_entry *item)
+{
+	size_t len = strlen(item->path);
+
+	return diff->base.pfxcomp(tree_item->path, item->path) == 0 &&
+		(unsigned char)tree_item->path[len] <= '/';
 }
 
-static int iterators_expand_until_not_tree_entry(diff_in_progress* info) 
+/*
+ * Tree iterators that do not autoexpand return tree entries.  Skip a pair
+ * of trees that have the same path and the same id, since their contents
+ * cannot produce deltas.  Expand any other tree before the diff looks at
