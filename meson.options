option(
    'update_translations',
    type: 'boolean',
    value: false,
    description: 'Update translation (*.ts) files when source files change',
)

option(
    'dev_build',
    type: 'string',
    value: '',
    description: 'Mark this build as a development build with the given description',
)

option(
    'tests',
    type: 'boolean',
    value: true,
    description: 'Build the unit test suite',
)
option(
    'ci_tests',
    type: 'boolean',
    value: false,
    description: 'Also run tests that mutate global settings (CI only)',
)

option(
    'flatpak',
    type: 'boolean',
    value: false,
    description: 'Building for Flatpak',
)
option(
    'debug_flatpak',
    type: 'boolean',
    value: false,
    description: 'Use Flatpak URLs for testing without a Flatpak build',
)

option(
    'bundled',
    type: 'boolean',
    value: false,
    description: 'On Linux, set an $ORIGIN rpath for a self-contained build (e.g. AppImage)',
)

option(
    'enable_update_over_gui',
    type: 'boolean',
    value: true,
    description: 'Enable updating Pawmmit from the GUI',
)

option(
    'bundle_libgit2',
    type: 'feature',
    value: 'auto',
    description: 'Bundle libgit2 with performance patches (auto: only if no system libgit2 is found)',
)

option(
    'debug_output',
    type: 'boolean',
    value: true,
    description: 'Print debug output (only reachable with the debug menu enabled)',
)
option(
    'debug_output_general',
    type: 'boolean',
    value: true,
    description: 'Enable general debug messages',
)
option(
    'debug_output_refresh',
    type: 'boolean',
    value: false,
    description: 'Enable debug messages for the refresh flow',
)

option(
    'github_client_id',
    type: 'string',
    value: '',
    description: 'GitHub OAuth application client ID (enables the GitHub sign-in flow)',
)
option(
    'github_client_secret',
    type: 'string',
    value: '',
    description: 'GitHub OAuth application client secret',
)
option(
    'gitea_client_id',
    type: 'string',
    value: '',
    description: 'Gitea OAuth application client ID (enables the Gitea sign-in flow)',
)
option(
    'gitea_client_secret',
    type: 'string',
    value: '',
    description: 'Gitea OAuth application client secret',
)
option(
    'luajit',
    type: 'feature',
    value: 'disabled',
    description: 'Use system LuaJIT 2.1+ over Lua 5.3+',
)